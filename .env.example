EDITOR_ENV=development
EDITOR_DATABASE_URL=sqlite:///./data/editor.db
EDITOR_DATA_DIR=./data
EDITOR_PUBLIC_ORIGIN=http://localhost:5190
EDITOR_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
EDITOR_AUTH_MODE=local
EDITOR_MAIL_MODE=console
# Shared development connects to a separately running ZOJ API.
EDITOR_AUTH_API_URL=http://127.0.0.1:8012/api
EDITOR_AUTH_BRIDGE_SECRET=
EDITOR_AUTH_CA_FILE=
EDITOR_SSO_COOKIE_DOMAIN=
EDITOR_SMTP_HOST=
EDITOR_SMTP_PORT=587
EDITOR_SMTP_USER=
EDITOR_SMTP_PASSWORD=
EDITOR_MAIL_FROM=ZOJ Editor <noreply@editor.zoj.kr>
EDITOR_RUNNER_IMAGE=zoj-editor-runtime:v1
EDITOR_WORK_DIR=./data/work
EDITOR_WORKER_CONCURRENCY=2
EDITOR_JOB_TIMEOUT_SECONDS=1800
EDITOR_STRESS_MAX_SECONDS=1800
EDITOR_SESSION_DAYS=7

# Optional server-to-server publishing; never send this secret to the browser.
EDITOR_ZOJ_API_URL=
EDITOR_ZOJ_PUBLIC_ORIGIN=https://zoj.kr
EDITOR_ZOJ_BRIDGE_SECRET=
EDITOR_ZOJ_CA_FILE=

# Per-job test/seed workers; total sandbox operations per worker process.
EDITOR_TEST_PARALLELISM=4
EDITOR_EXECUTION_CONCURRENCY=4

# Maximum compressed package upload: 2 GiB. Keep proxy limits in sync.
EDITOR_MAX_ARCHIVE_BYTES=2147483648

# Individual testcase, source and resource file limit (128 MiB).
EDITOR_MAX_UPLOAD_BYTES=134217728
