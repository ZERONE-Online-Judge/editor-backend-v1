include /etc/editor-traffic/active.conf;
geo $realip_remote_addr $editor_ingress_allowed {
    default 0;
    ${EDITOR_INGRESS_CIDR} 1;
}
server {
    listen 80;
    server_name editor.zoj.kr;
    client_max_body_size 2g;
    set_real_ip_from ${EDITOR_INGRESS_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    if ($editor_ingress_allowed = 0) { return 403; }
    location ^~ /assets/ {
        proxy_pass http://editor_frontend;
        proxy_intercept_errors on;
        error_page 404 = @previous_assets;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location @previous_assets {
        proxy_pass http://editor_previous_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://editor_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
    }
}
# Container-local probes exercise the same selected upstreams without making
# the public ingress ACL broader. This listener has no published host port.
server {
    listen 127.0.0.1:8081;
    location = /api/health { proxy_pass http://editor_api; }
    location = /release.txt { proxy_pass http://editor_frontend; }
}
