EDITOR_DB_PASSWORD=replace-with-random-alphanumeric-password
EDITOR_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
EDITOR_MAIL_MODE=zoj
EDITOR_MAIL_RELAY_URL=https://zoj.kr/api
EDITOR_MAIL_RELAY_SECRET=
EDITOR_MAIL_RELAY_CA_FILE=
EDITOR_SMTP_HOST=
EDITOR_SMTP_PORT=587
EDITOR_SMTP_USER=
EDITOR_SMTP_PASSWORD=
EDITOR_MAIL_FROM=ZOJ Editor <noreply@editor.zoj.kr>
EDITOR_STORAGE_ROOT=/srv/zoj-editor
EDITOR_DOCKER_GID=999
EDITOR_WORKER_CONCURRENCY=2
EDITOR_RUNTIME_REVISION=editor-runtime-0.1.2
EDITOR_BIND_ADDRESS=127.0.0.1
EDITOR_HTTP_PORT=8090
# Specify only the trusted reverse proxy IP, never 0.0.0.0/0.
EDITOR_INGRESS_CIDR=127.0.0.1/32

# Configure only after installing ZOJ's feature/editor-publishing receiver.
EDITOR_ZOJ_API_URL=
EDITOR_ZOJ_PUBLIC_ORIGIN=https://zoj.kr
EDITOR_ZOJ_BRIDGE_SECRET=
# Optional private CA mounted read-only into the API at /certs.
EDITOR_ZOJ_CA_FILE=
